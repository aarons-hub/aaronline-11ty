<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="{{ '/favicon.svg' | url }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/css/main.css' | url }}" />
    {% if page.url == '/' %}
    <link rel="stylesheet" href="{{ '/css/index.css' | url }}" />
    {% endif %}
    {% if page.url == '/projects/' %}
    <link rel="stylesheet" href="{{ '/css/projects.css' | url }}" />
    {% endif %}
    {% if page.url == '/services/' %}
    <link rel="stylesheet" href="{{ '/css/services.css' | url }}" />
    {% endif %}
    {% if page.url == '/contact/' %}
    <link rel="stylesheet" href="{{ '/css/contact.css' | url }}" />
    {% endif %}
    {% if page.url == '/ajax-test/' %}
    <link rel="stylesheet" href="{{ '/css/ajax-test.css' | url }}" />
    {% endif %}
  </head>
  <body>
    <div class="cover-bg"></div>
    {% include "header.njk" %}
    <main class="site-main">
      <h1 class="page-title">{{ title }}</h1>
      {{ content | safe }}
    </main>
    {% include "footer.njk" %}
    {% if page.url == '/projects/' %}
    <script src="{{ '/js/projects.js' | url }}" defer></script>
    {% endif %}
    {% if page.url == '/services/' %}
    <script src="{{ '/js/services.js' | url }}" defer></script>
    {% endif %}
    {% if page.url == '/contact/' %}
    <script src="{{ '/js/vendor/emailjs.min.js' | url }}" defer></script>
    <script src="{{ '/js/contact.js' | url }}" defer></script>
    {% endif %}
    {% if page.url == '/ajax-test/' %}
    <script src="{{ '/js/ajax-test.js' | url }}" defer></script>
    {% endif %}
  </body>
</html>
